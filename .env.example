# ============================================================
# RUN Rewards — environment variables
# Copy to .env.local for development. With NOTHING set (or DEMO_MODE=true)
# the app runs entirely on demo fixtures — full UI, no external calls.
# All secrets are server-side only; never prefix a secret with NEXT_PUBLIC_.
# ============================================================

# --- App ---------------------------------------------------------------
# Public origin of the deployed app (used for OAuth redirects + magic links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Force demo mode even when keys are configured (handy for design review)
DEMO_MODE=true

# --- Supabase ----------------------------------------------------------
# Project settings -> API. The anon key is safe to expose; the service
# role key bypasses RLS and must ONLY live in server env (Vercel env vars).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Strava (developers.strava.com) --------------------------------------
# Create an API application: Authorization Callback Domain must match
# NEXT_PUBLIC_APP_URL's host (e.g. rewards.runstore.co.za).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string you choose; echoed back during webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Filled in AFTER creating the webhook subscription (see README) — events
# with a different subscription id are rejected.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# --- Shopify (custom app on your store) ----------------------------------
# Admin -> Settings -> Apps and sales channels -> Develop apps -> Create app.
# Admin API scopes required: read_customers, read_orders, write_discounts.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Gait analysis bridge -------------------------------------------------
# Shared secret the RUN Analysis app sends as "Authorization: Bearer <key>"
# when POSTing results to /api/gait/ingest. Generate: openssl rand -hex 32
GAIT_APP_API_KEY=

# --- Scheduled jobs ---------------------------------------------------------
# Vercel sends this automatically to cron routes when CRON_SECRET is set
# in the project env. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Phase 3 (documented now, unused in Phase 1) ----------------------------
# Resend (email fallback for iOS users without push permission)
RESEND_API_KEY=
# Web Push VAPID keys. Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
